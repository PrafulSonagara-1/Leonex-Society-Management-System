# Environment & Server
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (MySQL / Hosted TiDB / Railway / Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=society_hub
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# JWT Authentication (Required: Minimum 32 random characters)
JWT_SECRET=replace-with-64-random-chars-do-not-use-defaults

# Clerk Authentication (Get from https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Super Admin Authorization (System Owner)
# Set strictly to your Clerk User ID (e.g., user_2bXy...)
SUPER_ADMIN_CLERK_USER_ID=user_placeholder_owner_clerk_id
# Optional: Pre-hashed bcrypt password for fallback Super Admin access (never store plaintext)
SUPER_ADMIN_PASSWORD_HASH=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Communications & Notifications
EMAIL_PROVIDER_API_KEY=placeholder_email_key
SMS_OR_WHATSAPP_API_KEY=placeholder_sms_key

# Hosted Storage (Cloudinary / S3 / Supabase)
STORAGE_BUCKET_NAME=placeholder_bucket
STORAGE_ACCESS_KEY=placeholder_access_key
STORAGE_SECRET_KEY=placeholder_secret_key

# Monitoring (Optional)
SENTRY_DSN=
